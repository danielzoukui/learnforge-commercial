# Copy to the repository root as `.env` and fill in:
#   cp deploy/.env.example .env
#
# Used by deploy/docker-compose.yml (single-host stack). Container platforms
# such as Northflank take these as secret-group variables instead of a file.

# --- Domain / TLS -----------------------------------------------------------
DOMAIN="learnforge.example.com"
PUBLIC_SITE_URL="https://learnforge.example.com"

# --- Database ---------------------------------------------------------------
# Only used by docker-compose. On a managed platform use the provider's
# connection string (DATABASE_URL or POSTGRES_URI) instead.
POSTGRES_PASSWORD="replace-with-a-long-random-password"
# DATABASE_SSL=require      # uncomment for managed providers whose CA chain is not in the image

# --- Hosted authentication (Supabase) ---------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# --- Stripe monetization ----------------------------------------------------
STRIPE_SECRET_KEY="sk_test_or_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_FAMILY="price_1UEz7K3ItjkrrGb20QhuWGdd"
STRIPE_PRICE_TEACHER="price_1UEz7Q3ItjkrrGb2WzldHDJt"
