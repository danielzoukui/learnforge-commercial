# LearnForge Commercial — Northflank deployment values
#
# These are the values the Northflank template (deploy/northflank.json) expects as
# template arguments / argument overrides. Paste them into
# Templates → learnforge-commercial → Settings → Arguments (use *argument
# overrides* for the four secrets — Northflank stores those outside version
# control) or into the service's secret group directly.
#
# Nothing in this file is a real credential: replace every placeholder.

# --- Public origin -----------------------------------------------------------
# The template defaults PUBLIC_SITE_URL to https://${refs.learnforge.ports.0.dns}
# (the Northflank-generated domain). Replace it with your own domain before you
# take live payments — it is used for Stripe success/cancel URLs and auth emails.
PUBLIC_SITE_URL="https://learnforge.example.com"

# --- Hosted authentication (Supabase → Project Settings → API) ---------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# --- Stripe ------------------------------------------------------------------
# Use sk_test_... first, run one test-mode purchase, then switch to sk_live_...
STRIPE_SECRET_KEY="sk_test_or_live_..."
# From the webhook endpoint you create for
# https://<your-domain>/commercial-api/stripe-webhook
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_FAMILY="price_1UEz7K3ItjkrrGb20QhuWGdd"
STRIPE_PRICE_TEACHER="price_1UEz7Q3ItjkrrGb2WzldHDJt"

# --- Provided automatically by the template (do not set by hand) -------------
# DATABASE_URL is linked from the PostgreSQL addon's POSTGRES_URI.
# NODE_ENV, HOST, PORT are set by the template.
